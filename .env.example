# KeeperHub
KEEPERHUB_API_KEY=kh_...
KEEPERHUB_BASE_URL=https://api.keeperhub.com

# Chain RPCs
RPC_URL_BASE=https://mainnet.base.org
RPC_URL_ETHEREUM=https://eth.llamarpc.com
RPC_URL_BASE_SEPOLIA=https://sepolia.base.org
RPC_URL_SEPOLIA=https://rpc.sepolia.org

# Basis quote MAC key (minimum 32 characters; HMAC-SHA-256 v2)
BASIS_SIGNING_KEY=

# Environment: local | testnet | production
BASIS_ENV=testnet

# Paid KeeperHub wrapper credentials (four distinct random values, at least 32 bytes each)
# Generate each with: openssl rand -base64 32
BASIS_ORDER_T1_SECRET=
BASIS_ORDER_T2_SECRET=
BASIS_ORDER_T3_SECRET=
BASIS_ORDER_T4_SECRET=

# Public HTTPS Basis URL used only by marketplace provisioning
BASIS_PUBLIC_BASE_URL=

# Optional exact chain/token/recipient/maxAmount policy. Empty disables erc20.transfer.
ERC20_TRANSFER_ALLOWLIST=

# Oracle safety. Production requires a fresh independently sourced reference and timestamp.
ORACLE_MAX_STALENESS_SECONDS=3600
ORACLE_MAX_DIVERGENCE_BPS=500
ORACLE_REFERENCE_ETH_USD=
ORACLE_REFERENCE_UPDATED_AT=

# Explicit local/test-only fallback; never accepted in production.
ALLOW_TEST_FX_FALLBACK=false
TEST_FX_FALLBACK_USD=
